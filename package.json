{
  "name": "@nocompromiseai/glm-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Z.ai GLM models (GLM-5.3 and siblings) as tools inside Claude Code and Claude Desktop.",
  "type": "module",
  "bin": {
    "glm-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && node --test test/glob.test.mjs test/api-key.test.mjs test/confinement.test.mjs",
    "verify:ignore": "node scripts/verify-ignore.mjs",
    "verify:globs": "node scripts/verify-globs.mjs",
    "verify:confinement": "node scripts/verify-confinement.mjs",
    "verify:limits": "node scripts/verify-limits.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "glm",
    "z.ai",
    "claude",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No-Compromise-AI/glm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/No-Compromise-AI/glm-mcp/issues"
  },
  "homepage": "https://github.com/No-Compromise-AI/glm-mcp#readme",
  "author": "No Compromise AI",
  "publishConfig": {
    "access": "public"
  }
}
