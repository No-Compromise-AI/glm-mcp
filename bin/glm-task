#!/usr/bin/env bash
# Delegate a coding task to a headless GLM-5.3 agent, verify it independently,
# have a DIFFERENT model review it against the spec, and record the outcome.
#
#   glm-task -v "npm test" "Implement github issue 123"
#   glm-task -C ~/proj -v "pnpm check" -r codex "Work phase 1 of docs/11-engineering-plan.md"
#
#   -C <dir>   working directory (default: cwd)
#   -v <cmd>   verify command, run AFTER the agent; its exit code is what gets recorded
#   -r <who>   review with codex|claude|glm|agy|none   (default: codex, none if unavailable)
#   -x <n>     max fix rounds after a failed review (default 1, 0 disables)
#   -W         run in an isolated git worktree on its own branch, so several
#              delegations can run at once without sharing a checkout
#   -b <name>  as -W, with an explicit branch name
#   -t <tools> override the tool allowlist
#
# Outcomes append to $GLM_TASK_LEDGER (default ~/.claude-glm/outcomes.jsonl).
#
# Exit codes, checked in this order — the first that applies wins:
#   0  verified and reviewed
#   5  rate limited — the run was NOT attempted; retry later
#   4  BLOCKED — the agent stopped to ask a question
#   6  the delegated agent did not complete — it could not start, died, was
#      killed, reported failure, or exited non-zero despite a clean result;
#      OR it finished having committed NOTHING to the branch that will be
#      shipped: it left files uncommitted in the tree (named in the ledger's
#      worker_reason — they are still recoverable until the worktree is
#      deleted), it made no change at all, or it put its commits on some other
#      branch than the one glm-ship pushes; OR git could not say what the
#      branch carries, so no change can be certified. glm-ship pushes commits
#      onto the branch this run names, so in every one of these the branch
#      carries no change, and a verify that passed counts for nothing: -v runs
#      against the working tree and is satisfied by uncommitted files.
#      glm-task never commits on the agent's behalf — it refuses and says so.
#   1  a change WAS produced and was judged wanting — verify failed, or the
#      reviewer required changes
#   2  UNREVIEWED — the review errored; nothing checked the change
#   3  every reviewer is out of capacity
# 1 and 6 are distinct on purpose: a human reading a parked item needs to know
# whether work happened and fell short, or never happened at all.
set -uo pipefail

# Resolve this script's own directory, following symlinks, so the sibling tools
# are found wherever the family is installed. These are invoked through symlinks
# in ~/.local/bin, so dirname "$0" alone would resolve to the symlink's home.
__self="${BASH_SOURCE[0]}"
while [[ -L "$__self" ]]; do
  __dir="$(cd -P "$(dirname -- "$__self")" && pwd)"
  __self="$(readlink -- "$__self")"
  [[ "$__self" != /* ]] && __self="$__dir/$__self"
done
HERE="$(cd -P "$(dirname -- "$__self")" && pwd)"
. "$HERE/_glm-hosts.sh"
. "$HERE/_glm-capacity.sh"

DIR="$PWD"; VERIFY=""; TOOLS_OVERRIDE=""; REVIEWER="${GLM_REVIEWER:-auto}"; FIXES=1
ISOLATE=0; BRANCH=""; LINKED_NM=0
while getopts "C:v:t:r:x:Wb:h" opt; do
  case "$opt" in
    C) DIR="$OPTARG" ;; v) VERIFY="$OPTARG" ;; t) TOOLS_OVERRIDE="$OPTARG" ;;
    r) REVIEWER="$OPTARG" ;; x) FIXES="$OPTARG" ;;
    W) ISOLATE=1 ;; b) BRANCH="$OPTARG"; ISOLATE=1 ;;
    h) grep '^#' "$0" | sed 's/^# \{0,1\}//' | head -14; exit 0 ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -ge 1 ]] || { echo 'usage: glm-task [-C dir] [-v cmd] [-r reviewer] "<task>"' >&2; exit 2; }
TASK="$*"
# Resolve auto/all against the host, then drop any reviewer whose CLI is not
# installed. The old line knew only how to disable codex.
REVIEWER="$(glm_resolve_reviewers "$REVIEWER")"
AVAIL=""
for _r in $REVIEWER; do
  _cmd="$_r"; [[ "$_r" == "glm" ]] && _cmd="$HERE/glm-worker"
  if command -v "$_cmd" >/dev/null 2>&1 || [[ -x "$_cmd" ]]; then
    AVAIL="${AVAIL:+$AVAIL,}$_r"
  else
    echo "glm-task: reviewer '$_r' is not installed — skipping it" >&2
  fi
done
REVIEWER="${AVAIL:-none}"

DEFAULT_TOOLS=(
  "Bash(node:*)" "Bash(npm:*)" "Bash(pnpm:*)" "Bash(yarn:*)"
  "Bash(python3:*)" "Bash(pytest:*)" "Bash(make:*)" "Bash(dotnet:*)"
  "Bash(cargo:*)" "Bash(go:*)" "Bash(git:*)" "Bash(gh:*)" "Bash(az:*)" "Bash(printf:*)"
  Read Edit Write Glob Grep
)
if [[ -n "$TOOLS_OVERRIDE" ]]; then read -r -a TOOLS <<< "$TOOLS_OVERRIDE"
elif [[ -n "${GLM_TASK_TOOLS:-}" ]]; then read -r -a TOOLS <<< "$GLM_TASK_TOOLS"
else TOOLS=("${DEFAULT_TOOLS[@]}"); fi

STAMP="$(date +%Y%m%d-%H%M%S)-$$"   # PID suffix: same-second launches must not share paths
LOG="${GLM_TASK_LOG:-${TMPDIR:-/tmp}/glm-task-$STAMP.jsonl}"
LEDGER="${GLM_TASK_LEDGER:-$HOME/.claude-glm/outcomes.jsonl}"
SPECF="${TMPDIR:-/tmp}/glm-spec-$STAMP.txt"
NOTES="${GLM_NOTES:-${TMPDIR:-/tmp}/glm-notes-$STAMP.jsonl}"
REVF="${TMPDIR:-/tmp}/glm-review-$STAMP.txt"
# glm-review explains itself on stderr — which reviewer ran, which timed out,
# which was out of capacity, why no verdict came back. That was going to
# /dev/null, so every review=error was recorded with an EMPTY review_text:
# 9 of 9 in the ledger. The one thing you need when a review fails is the
# reason it failed (#74). Kept separate from REVF so progress chatter never
# reaches the findings the verdict is parsed from.
REVERR="${TMPDIR:-/tmp}/glm-review-$STAMP.err"
# glm-review's machine-readable account of who reviewed, with what model, and
# who did not and why. Kept beside the findings rather than parsed back out of
# them: the findings are prose written by a model, and a record built by
# re-reading prose is a record that can be wrong about itself (#82).
REVREC="${TMPDIR:-/tmp}/glm-review-$STAMP.json"
mkdir -p "$(dirname "$LEDGER")"
printf '%s\n' "$TASK" > "$SPECF"


ESCALATION="

---
Reaching the human: append ONE line of JSON to $NOTES when — and only when — something
genuinely needs their attention. Use:

  printf '%s\\n' '{\"level\":\"blocked\",\"msg\":\"...\"}' >> $NOTES

Levels:
  blocked    you have stopped and need a decision before you can continue
  scope      the spec is wrong, self-contradictory, or impossible as written
  discovery  you found something outside this task they would want to know about
             — a real bug, a security problem, a data-loss risk
  decision   you proceeded on an assumption that could turn out to be wrong

Do NOT write a note for: progress, what you are about to do, files you edited, tests
passing, routine choices with an obvious default, or anything they will read in your
final report anyway.

Default to silence. A note spends their attention. Spend it only when the alternative
is them finding out too late to act."

# Concurrency: agents sharing one checkout will commit to whatever branch happens
# to be current and overwrite each other. A worktree gives each run its own
# directory and branch over the same object store.
PARENT_DIR="$DIR"; WORKTREE=""
if [[ $ISOLATE -eq 1 ]]; then
  git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || { echo "glm-task: -W needs a git repo" >&2; exit 2; }
  BRANCH="${BRANCH:-glm/$STAMP}"
  WORKTREE="${GLM_WORKTREE_ROOT:-${TMPDIR:-/tmp}}/glm-wt-$STAMP"
  # An EXISTING branch is continued rather than refused. The workflow this repo
  # follows is to commit the acceptance gate on a branch named for the work and
  # then delegate against it, which is exactly the case `worktree add -b`
  # rejects (#78).
  #
  # That abort was also, accidentally, the only thing keeping two runs off one
  # branch. Removing it without replacing it would give up the guarantee, so the
  # replacement is explicit and narrower: reuse only a branch nothing else has
  # checked out. `git worktree add` refuses a branch that is checked out
  # elsewhere on its own, but its error is git's, not ours, so the case is
  # detected first and explained in the tool's own words.
  if git -C "$DIR" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    if git -C "$DIR" worktree list --porcelain | grep -qx "branch refs/heads/$BRANCH"; then
      echo "glm-task: branch '$BRANCH' is already checked out in another worktree." >&2
      echo "glm-task: two runs on one branch commit over each other. Finish or remove that worktree (git worktree list), or pick another -b name." >&2
      exit 2
    fi
    # From the branch's own tip, NOT from HEAD: continuing the work means
    # keeping whatever is already on it.
    echo "glm-task: reusing existing branch '$BRANCH' — continuing it from its own tip, not from HEAD" >&2
    if ! git -C "$DIR" worktree add -q "$WORKTREE" "$BRANCH" 2>&1; then
      echo "glm-task: could not create worktree $WORKTREE on existing branch $BRANCH" >&2; exit 2
    fi
  elif ! git -C "$DIR" worktree add -q -b "$BRANCH" "$WORKTREE" HEAD 2>&1; then
    echo "glm-task: could not create worktree $WORKTREE on $BRANCH" >&2; exit 2
  fi
  # Share installed deps rather than reinstalling per run. LINKED_NM remembers
  # the symlink is OURS, so the uncommitted-work check below does not report it
  # as work the agent left behind.
  if [[ -d "$PARENT_DIR/node_modules" && ! -e "$WORKTREE/node_modules" ]]; then
    ln -s "$PARENT_DIR/node_modules" "$WORKTREE/node_modules"
    LINKED_NM=1
  fi
  echo "glm-task: isolated worktree=$WORKTREE branch=$BRANCH" >&2
  DIR="$WORKTREE"
fi

cd "$DIR" || exit 1
BASE="$(git rev-parse HEAD 2>/dev/null || echo '')"
# What this run touched, for the ledger row (#77). A -W/-b run has already
# named the branch it created; an in-place run shares a checkout, and the
# branch it stands on is the only honest attribution — attribution is not a
# property of isolation. Detached HEAD names no branch: symbolic-ref prints
# nothing and the row records null rather than a guess. symbolic-ref rather
# than `branch --show-current` because it predates the git bin/ has to run on.
if [[ -z "$BRANCH" ]]; then
  BRANCH="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
fi
echo "glm-task: dir=$DIR base=${BASE:0:8} branch=${BRANCH:-none} reviewer=$REVIEWER" >&2
echo "glm-task: log=$LOG" >&2
echo "glm-task: notes=$NOTES" >&2

trace() {
  python3 -u -c "
import json,sys
for line in sys.stdin:
    try:
        e=json.loads(line)
        t=e.get('type')
        if t=='assistant':
            for c in e.get('message',{}).get('content',[]):
                if c.get('type')=='text' and c.get('text','').strip():
                    sys.stderr.write('  '+c['text'].strip()[:200]+chr(10))
                elif c.get('type')=='tool_use':
                    sys.stderr.write('  . '+str(c.get('name'))+chr(10))
        elif t=='result':
            sys.stderr.write('  -- '+str(e.get('num_turns'))+' turns, '+str((e.get('duration_ms') or 0)//1000)+'s'+chr(10))
        sys.stderr.flush()
    except Exception: continue
"
}

run_agent() { # $1 = prompt, $2 = log path
  # The notes file lives outside the repo, so its directory must be an allowed
  # working directory or every escalation write is silently denied.
  "$HERE/glm-worker" -p "$1" \
    --permission-mode acceptEdits --allowedTools "${TOOLS[@]}" \
    --add-dir "$(dirname "$NOTES")" \
    --output-format stream-json --verbose 2>&1 | tee "$2" | trace
  # The worker's own exit status, read HERE and nowhere else: this function
  # runs several more commands after the pipeline, and each one overwrites $?
  # — the trailing if was always 0, so a worker that died took its status
  # with it and the run was recorded as though nothing had happened (#91).
  # PIPESTATUS[0], not $?: tee and trace are ours; only element 0 is the
  # worker speaking.
  WORKER_RC="${PIPESTATUS[0]}"
  # Throttling is not failure. If z.ai refused on capacity, the run produced no
  # information about the change: a caller must be able to wait and retry rather
  # than burn the item. Read from the log because the pipeline above consumed
  # stdout, and take the LAST 4000 characters — the refusal arrives at the end,
  # and a whole stream-json log would match the words in the task text itself.
  # Scoped to the run's OWN outcome, not its prose. The first version scanned
  # the raw tail of the stream, so an agent that SUCCEEDED at a task about rate
  # limiting — "Implemented rate-limit handling; all tests pass" — matched the
  # detector and was reported as throttled. Since a throttled item is requeued,
  # that task could never finish: it retried forever, and the task most likely
  # to trip it was building the drain itself.
  #
  # A run that produced a successful result was not throttled, whatever words
  # are in it. So the question is asked only of a run that FAILED, and only of
  # its error text.
  ERRTEXT="$(GLM_LOGF="$2" python3 - <<'PYEOF'
import json, os
res = None
try:
    for line in open(os.environ["GLM_LOGF"]):
        if line.startswith("{") and '"type":"result"' in line:
            try: res = json.loads(line)
            except Exception: pass
except Exception: pass
# No result event at all means the run died before finishing — its tail is the
# only evidence there is, so fall back to it.
if res is None:
    try: print(open(os.environ["GLM_LOGF"]).read()[-4000:])
    except Exception: pass
elif res.get("is_error") or res.get("subtype") != "success":
    print(str(res.get("result") or res.get("error") or "")[:4000])
PYEOF
)"
  if [[ -n "$ERRTEXT" ]] && glm_is_exhausted "$ERRTEXT"; then
    RATE_LIMITED=1
    RETRY_AFTER="$(glm_retry_after "$ERRTEXT")"
  fi
  # DID THE AGENT COMPLETE? A caller can see the worker through exactly two
  # channels — its exit status and its stream-json — and neither alone is
  # enough. The status alone misses an agent that ran and reported failure
  # (is_error, exit 0); the result event alone misses a worker that never
  # emitted one, and certifies a worker that reported success and then exited
  # non-zero anyway. Completion is the CONJUNCTION — a clean result event AND
  # exit 0 — and everything else lands here (#91):
  #   (a) non-zero exit, no result    — it could not start, or it died;
  #   (b) result with is_error, or a subtype other than success;
  #   (c) zero exit, no result at all — killed, truncated, stopped between events;
  #   (d) a clean result beside a NON-ZERO exit — the channels disagree, and a
  #       disagreement is not a completion: something failed after the result,
  #       or the log is stale, and a success here is what an unattended drain
  #       merges on.
  # Both halves, or a delegation that never ran reports success. Anything this
  # cannot classify reads as NOT complete: the honest direction to fail in.
  # Read from the log, like ERRTEXT, because the pipeline consumed stdout.
  # (Both PYEOF heredocs below: keep apostrophes and any other unbalanced
  # quote character out of the bodies. bash 3.2 — the floor bin/ targets —
  # scans a heredoc body for quotes even here, inside a command substitution
  # behind a quoted delimiter, and one apostrophe fails the parse at EOF,
  # nowhere near the line that caused it.)
  WORKER_OK=0; WORKER_REASON=""
  WORKER_VERDICT="$(GLM_LOGF="$2" GLM_WRC="$WORKER_RC" python3 - <<'PYEOF'
import json, os
res = None
try:
    for line in open(os.environ["GLM_LOGF"]):
        if line.startswith("{") and '"type":"result"' in line:
            try: res = json.loads(line)
            except Exception: pass
except Exception: pass
if res is None:
    print("0\tthe worker exited %s without emitting a result event - it could not start, died, or was killed mid-run" % os.environ["GLM_WRC"])
elif res.get("is_error") or res.get("subtype") != "success":
    # The verdict travels as ok<TAB>reason, so the reason itself must be
    # tab-free and one line or it would split its own field.
    detail = " ".join(str(res.get("result") or res.get("error") or "").split())[:300]
    why = "the worker ran and reported %s" % (res.get("subtype") or "an error")
    print("0\t%s%s" % (why, ": " + detail if detail else ""))
elif os.environ["GLM_WRC"] != "0":
    # Shape (d): the result event is clean, but the worker exit status says
    # otherwise. Reading only the log here certified exactly this
    # contradiction as success, and glm-drain ships on a zero exit.
    print("0\tthe worker exited %s after reporting a successful result - its exit status contradicts its own result event" % os.environ["GLM_WRC"])
else:
    print("1\t")
PYEOF
)"
  WORKER_OK="${WORKER_VERDICT%%$'\t'*}"
  WORKER_REASON="${WORKER_VERDICT#*$'\t'}"
}

do_verify() {
  [[ -n "$VERIFY" ]] || { VSTATUS="skipped"; VRC=""; return 0; }
  echo "glm-task: verifying -> $VERIFY" >&2
  if eval "$VERIFY" >/dev/null 2>&1; then VSTATUS="pass"; VRC=0
  else VRC=$?; VSTATUS="fail"; fi
  echo "glm-task: verify=$VSTATUS" >&2
}

: > "$NOTES"
# Levels that interrupt the human. Blocked halts the agent, so it is the one that
# actually needs them; widen with GLM_NOTIFY_LEVELS if you want more.
NOTIFY_LEVELS="${GLM_NOTIFY_LEVELS:-blocked}"
( tail -f "$NOTES" 2>/dev/null | while IFS= read -r n; do
    lvl=$(printf '%s' "$n" | sed -n 's/.*"level":"\([a-z]*\)".*/\1/p')
    msg=$(printf '%s' "$n" | sed -n 's/.*"msg":"\(.*\)"}.*/\1/p')
    case "$lvl" in
      blocked|scope|discovery) echo "  >>> GLM [$lvl]: $msg" >&2 ;;
    esac
    if printf '%s' "$NOTIFY_LEVELS" | grep -qw "$lvl"; then
      short=$(printf '%s' "$msg" | cut -c1-180)
      osascript -e "display notification \"$(printf '%s' "$short" | sed 's/"/\\"/g')\" with title \"GLM is blocked\" subtitle \"$(basename "$DIR")\" sound name \"Ping\"" >/dev/null 2>&1 || true
      printf '\a' >&2
    fi
  done ) & TAILPID=$!
# tail -f never exits on its own; without this the watcher outlives the run.
cleanup_tail() {
  [[ -n "${TAILPID:-}" ]] || return 0
  pkill -P "$TAILPID" 2>/dev/null
  kill "$TAILPID" 2>/dev/null
  TAILPID=""
}
trap cleanup_tail EXIT INT TERM

run_agent "$TASK$ESCALATION" "$LOG"
sleep 1; cleanup_tail

# DID THE DELEGATION LEAVE A CHANGE ON THE BRANCH THAT WILL BE SHIPPED?
# glm-ship pushes COMMITS, and the drain ships the branch this run names in its
# run line — not whatever the agent left HEAD pointing at. So the named branch
# is what gets counted: an agent that commits to a side branch, or detaches or
# orphans HEAD, has produced nothing the ship can carry, however much work it
# did. Uncommitted files are discarded with the worktree while every other
# signal — a green verify above all, since -v runs against the working tree and
# is perfectly happy with uncommitted work — says the item succeeded (#93).
# Same property as #91 one step further on: there the agent never ran, here it
# ran and left no trace on the branch that ships.
#
# Measured at each agent's exit, BEFORE do_verify — the files listed must be
# the agent's work, not artifacts a verify command left behind — and measured
# AGAIN after every fix round: a fix worker can undo the commits the first
# round made while reworking them, and a stale count re-reviews a diff already
# known to be empty, recording "the reviewer broke" for what is really
# "nothing is committed".
#
# Counted only against a base commit: with no git base ($BASE empty) there is
# nothing to count, and such a run must neither crash nor start failing here.
# A git that cannot answer — the agent broke the worktree's git, deleted the
# branch, or left HEAD unborn — fails CLOSED: this check is what certifies a
# change exists, and "cannot tell" is not a certificate. The first version
# failed open ("assume a change"), which let a worker that had wrecked the
# worktree's git report success on no evidence at all.
#
# glm-task does NOT commit the work itself, ever. That would invent an author
# and a commit message and sweep in whatever else the tree happened to hold;
# the fix for "nothing was committed" is to refuse and say so, leaving the
# files exactly where the agent left them. The outcomes are different facts
# and are worded differently: files left uncommitted are work a human can
# still recover if the reason NAMES them, which is why they are listed.
SHIPREF="HEAD"
[[ $ISOLATE -eq 1 ]] && SHIPREF="refs/heads/$BRANCH"
NEW_COMMITS=""; COUNT_OK=0; UNCOMMITTED_FILES=""; UNCOMMITTED_COUNT=0
LEFT_UNCOMMITTED=0; STATE_UNKNOWN=0
check_committed() { # counts what the SHIPPED branch carries; may demote WORKER_OK
  local _count="" _count_ok=0 _st="" _status_ok=0 _names="" _head_tip="" _ship_tip="" _cur=""
  NEW_COMMITS=""; COUNT_OK=0; UNCOMMITTED_FILES=""; UNCOMMITTED_COUNT=0
  LEFT_UNCOMMITTED=0; STATE_UNKNOWN=0
  [[ -z "$BASE" ]] && return 0
  _count="$(git rev-list --count "$BASE..$SHIPREF" 2>/dev/null)" && _count_ok=1
  # -uall: without it porcelain collapses an untracked directory to "?? new/",
  # so files the agent is about to lose are never named (rule 11 asks for the
  # names, not the directory) — and a repo-local status.showUntrackedFiles=no
  # empties the output entirely, turning "left work uncommitted" into the
  # confidently wrong "produced no change at all". -uall overrides both.
  _st="$(git status --porcelain -uall 2>/dev/null)" && _status_ok=1
  if [[ "$_count" =~ ^[0-9]+$ ]]; then NEW_COMMITS="$_count"; fi
  [[ "$_count_ok" == "1" && "$_status_ok" == "1" && -n "$NEW_COMMITS" ]] && COUNT_OK=1
  # -W links node_modules into the worktree so runs share installed deps; that
  # symlink is ours, not the agent's work, and must not be named as work the
  # agent "left uncommitted". Trailing slash dropped: porcelain marks untracked
  # directories with one.
  _names="$(printf '%s\n' "$_st" | sed -e 's/^...//' -e 's:/$::')"
  if [[ "${LINKED_NM:-0}" == "1" ]]; then
    _names="$(printf '%s\n' "$_names" | grep -vx node_modules)"
  fi
  UNCOMMITTED_COUNT="$(printf '%s\n' "$_names" | grep -c .)"
  UNCOMMITTED_FILES="$(printf '%s\n' "$_names" | head -10 | awk '{printf "%s%s", (NR>1?", ":""), $0}')"
  # Ten names is enough to recognise the work; beyond that the count says more
  # than the list would.
  if [[ "$UNCOMMITTED_COUNT" -gt 10 ]]; then
    UNCOMMITTED_FILES="$UNCOMMITTED_FILES, and $((UNCOMMITTED_COUNT - 10)) more"
  fi
  # An agent that already failed keeps its own, more specific reason; a branch
  # that COUNTS as carrying a change has nothing to demote. Everything else —
  # including a git that could not answer — falls through to refuse.
  [[ "${WORKER_OK:-0}" == "1" ]] || return 0
  # COUNT_OK already means "both probes answered". Re-deriving "we know enough
  # to proceed" from _count_ok alone let a run whose git could count commits but
  # could not read the tree keep WORKER_OK=1 — while the review guard, which
  # requires COUNT_OK, skipped the reviewer. Exit 0, branch shipped, nobody read
  # it. Two conditions that must agree must not be written twice.
  [[ "$COUNT_OK" == "1" && "$NEW_COMMITS" != "0" ]] && return 0
  WORKER_OK=0
  if [[ "$COUNT_OK" != "1" ]]; then
    # The count failed, or answered zero while the tree's state — clean, or
    # holding work worth recovering — could not be read.
    STATE_UNKNOWN=1
    if [[ "$_count_ok" != "1" || ! "$NEW_COMMITS" =~ ^[0-9]+$ ]]; then
      WORKER_REASON="git could not count what $SHIPREF carries since the base - the worktree git is broken or the ref is gone, so no change can be certified"
    elif [[ "$NEW_COMMITS" == "0" ]]; then
      WORKER_REASON="git could not read the working tree to say what was left in it - with nothing committed, no change can be certified"
    else
      # The count answered, and answered non-zero: the branch DOES carry
      # commits. Saying "nothing was committed" here would be false, and a
      # false reason is the same defect as a false exit code — it sends whoever
      # reads the row looking for the wrong thing.
      WORKER_REASON="$SHIPREF carries $NEW_COMMITS commit(s), but git could not read the working tree, so whether the agent also left work behind cannot be certified"
    fi
  elif [[ "$UNCOMMITTED_COUNT" -gt 0 ]]; then
    LEFT_UNCOMMITTED=1
    WORKER_REASON="the agent finished its session but left ${UNCOMMITTED_COUNT} file(s) uncommitted: ${UNCOMMITTED_FILES}. Nothing was committed to the branch, so there is no change to ship — the files are still in the working tree"
  else
    # Clean tree, nothing on the branch that ships. When the worktree is left
    # pointing somewhere else, the agent may well have worked — on a ref the
    # ship will never push, which is a different fact from no work at all.
    _head_tip="$(git rev-parse HEAD 2>/dev/null)"
    _ship_tip="$(git rev-parse "$SHIPREF" 2>/dev/null)"
    if [[ $ISOLATE -eq 1 && ( -z "$_head_tip" || "$_head_tip" != "$_ship_tip" ) ]]; then
      _cur="$(git branch --show-current 2>/dev/null)"
      WORKER_REASON="the agent finished its session but committed nothing to ${BRANCH}, the branch that will be shipped - the worktree is left on ${_cur:-a detached or unborn HEAD}, so any work it did sits on a ref the ship will not push"
    else
      WORKER_REASON="the agent finished its session but produced no change at all: no commit since base and the working tree is clean"
    fi
  fi
}
check_committed

do_verify

REVIEW_VERDICT="skipped"; ROUNDS=0
# Nothing committed means nothing to review. Handing glm-review a diff already
# known to be empty spends a reviewer call to obtain an empty-diff error, and
# storing that error as the run's review state is how this defect read as "the
# reviewer keeps breaking" for two rounds. The verdict says there was nothing
# to review — not that the reviewer failed. Review runs only on a COUNTED
# change: with the count unknown there is no diff to hand over either, and the
# run is being refused regardless.
if [[ -n "$BASE" && "$COUNT_OK" == "1" && "$NEW_COMMITS" == "0" ]]; then
  REVIEW_VERDICT="nothing_to_review"
  echo "glm-task: nothing committed since base — skipping review, there is no diff to judge" >&2
elif [[ "$REVIEWER" != "none" && -n "$BASE" && "$COUNT_OK" == "1" ]]; then
  # -H: judge the branch that will be SHIPPED. The agent can leave the
  # worktree's HEAD elsewhere than the ship branch; reviewing HEAD would
  # approve a diff the ship never pushes.
  GLM_REVIEW_RECORD="$REVREC" "$HERE/glm-review" -C "$DIR" -b "$BASE" -H "$SHIPREF" -s "$SPECF" -r "$REVIEWER" > "$REVF" 2>>"$REVERR"
  rc=$?
  case $rc in 0) REVIEW_VERDICT="pass" ;; 1) REVIEW_VERDICT="changes_required" ;;
             3) REVIEW_VERDICT="no_capacity" ;; *) REVIEW_VERDICT="error" ;; esac
  echo "glm-task: review=$REVIEW_VERDICT" >&2
  sed 's/^/  | /' "$REVF" | head -30 >&2
  # A review that produced no verdict has nothing in REVF worth printing; its
  # diagnosis is in stderr, so show that instead of nothing.
  if [[ "$REVIEW_VERDICT" == "error" || "$REVIEW_VERDICT" == "no_capacity" ]]; then
    tail -20 "$REVERR" 2>/dev/null | sed 's/^/  ! /' >&2
  fi

  while [[ "$REVIEW_VERDICT" == "changes_required" && $ROUNDS -lt $FIXES ]]; do
    ROUNDS=$((ROUNDS+1))
    echo "glm-task: fix round $ROUNDS" >&2
    FIXLOG="${LOG%.jsonl}-fix$ROUNDS.jsonl"
    # The record below must describe the session that ran LAST. A fix round is
    # a fresh session, so a blocked fix round resumed the ORIGINAL session — the
    # one that had already finished — instead of the one asking the question.
    LASTLOG="$FIXLOG"
    run_agent "A reviewer examined your change against the original task and asked for changes.

Reviewers are often wrong. In measured testing one reviewer's findings were 40% false
positives. Treat every finding below as a CLAIM TO BE TESTED, not as an instruction.

ORIGINAL TASK:
$TASK

REVIEW FINDINGS:
$(cat "$REVF")

Follow this protocol in order:

1. REPRODUCE FIRST. For each finding, write a concrete check — a script, a test, a command —
   that demonstrates the claimed behaviour. Change no source code during this step.
2. Fix only the findings you actually reproduced.
3. For each finding you could NOT reproduce, report the exact check you ran and its output
   showing the claim is wrong. Do NOT edit code to satisfy a claim you could not reproduce:
   changing working code to appease a false finding is worse than leaving it unaddressed.
4. For every finding that was real, add a real unit test that FAILS before your fix and
   PASSES after it. A test asserting a constant is not a test.
5. Re-run the full verification, then commit.

Report at the end: which findings you reproduced and fixed, and which you refuted and why." "$FIXLOG"
    # Re-measure before any further verify or review, exactly as after the
    # first agent: a fix worker can undo the commits it was asked to rework,
    # and the count taken before the first review is stale by now. Without
    # this, the re-review below was spent on a diff already known to be empty,
    # its empty-diff error was recorded as the run's review state, and the
    # uncommitted rework was never named.
    check_committed
    do_verify
    if [[ "$COUNT_OK" != "1" || "$NEW_COMMITS" == "0" ]]; then
      if [[ "$COUNT_OK" == "1" ]]; then REVIEW_VERDICT="nothing_to_review"; fi
      echo "glm-task: nothing committed to the branch after round $ROUNDS — no diff to review" >&2
      break
    fi
    GLM_REVIEW_RECORD="$REVREC" "$HERE/glm-review" -C "$DIR" -b "$BASE" -H "$SHIPREF" -s "$SPECF" -r "$REVIEWER" > "$REVF" 2>>"$REVERR"
    rc=$?
    # Same mapping as the first review, exit 3 included. Omitting it here turned
    # "every reviewer was out of capacity" into "error", which glm-task reports as
    # exit 2 = UNREVIEWED — and a caller parks that permanently. Capacity is a wait,
    # not a verdict, and the same fact must not change meaning because it happened
    # after a fix round rather than before one.
    case $rc in 0) REVIEW_VERDICT="pass" ;; 1) REVIEW_VERDICT="changes_required" ;;
               3) REVIEW_VERDICT="no_capacity" ;; *) REVIEW_VERDICT="error" ;; esac
    echo "glm-task: review=$REVIEW_VERDICT (after round $ROUNDS)" >&2
  done
fi

GLM_LOG="${LASTLOG:-$LOG}" GLM_LEDGER="$LEDGER" GLM_DIR="$DIR" GLM_TASK_TEXT="$TASK" \
GLM_VERIFY="$VERIFY" GLM_VSTATUS="${VSTATUS:-skipped}" GLM_VRC="${VRC:-}" \
GLM_WORKER_OK="${WORKER_OK:-}" GLM_WORKER_REASON="${WORKER_REASON:-}" \
GLM_REVIEWER="$REVIEWER" GLM_RVERDICT="$REVIEW_VERDICT" GLM_ROUNDS="$ROUNDS" \
GLM_NOTES_F="$NOTES" GLM_REVF="$REVF" GLM_REVERR="$REVERR" GLM_BASE="$BASE" GLM_BRANCH="${BRANCH:-}" \
GLM_REVREC="$REVREC" python3 - <<'PY'
import json, os, re, datetime
res={}
try:
    for line in open(os.environ["GLM_LOG"]):
        if line.strip().startswith("{"):
            try:
                e=json.loads(line)
                if e.get("type")=="result": res=e
            except Exception: pass
except FileNotFoundError: pass
try: review=open(os.environ["GLM_REVF"]).read()[:4000]
except Exception: review=""
# Reviewers cite absolute paths inside the worktree they read, and an isolated
# run's worktree is deleted when the run ends — so every link in the stored
# review pointed at nothing (#78). Only THIS run's own prefix is removed:
# the line numbers were already correct, and a rewrite that stripped anything
# path-shaped would mangle findings that legitimately name a file elsewhere.
_wt = os.environ.get("GLM_DIR") or ""
if _wt:
    for _p in (_wt.rstrip("/") + "/", os.path.realpath(_wt).rstrip("/") + "/"):
        review = review.replace(_p, "")
# A review that delivered no verdict leaves REVF empty, and an empty
# review_text is how 9 of 9 errored reviews were recorded as though nothing
# had happened (#74). The reason lives on glm-review's stderr; keep it, so the
# record says WHY rather than only that it failed.
if not review.strip():
    try:
        err = open(os.environ["GLM_REVERR"]).read().strip()
        if err: review = "(no verdict; glm-review reported)\n" + err[-4000:]
    except Exception: pass
notes=[]
try:
    for ln in open(os.environ["GLM_NOTES_F"]):
        ln=ln.strip()
        if ln.startswith("{"):
            try: notes.append(json.loads(ln))
            except Exception: notes.append({"level":"malformed","msg":ln[:200]})
except Exception: pass
if notes:
    print("\nglm-task: the agent raised %d item(s) for you:" % len(notes))
    for n in notes:
        print("  [%s] %s" % (n.get("level","?"), (n.get("msg") or "")[:300]))
# Which GitHub issue the task names, or None — never a bare number (#77).
# Only the three forms a task is actually written in here: "#123",
# "issue 123", and the "gh issue view 123" line the /glm skill tells callers
# to embed. A task saying "raise the timeout to 300 seconds" names no issue,
# and a greedy digit scan would attribute work to an issue nobody touched:
# absent is honestly unknown, wrong is a quietly false retro. First mention
# wins when a task names several.
# The number is only an issue number when the task SAYS issue. Requiring the
# word is what makes a pull request number impossible to mistake for one —
# GitHub numbers issues and PRs from a single sequence, so "#45" alone is a real
# number for a real thing that may not be this run's issue.
#
# The first version matched a bare "#n" and then tried to suppress the ones
# preceded by "PR". Review found that guard failing in both directions at once:
# it swallowed the unambiguous "Review PR (issue 50)", and leaked on "Review PRs
# #45 and #46" — and its tail is unbounded ("backport of #45", "closes #45").
# A heuristic that needs a second heuristic to correct it is the wrong shape;
# requiring the word needs no guard at all, and every case the reviewer raised
# falls out of it.
_rx_issue = re.compile(r"\bissues?\s*#?\s*([0-9]+)\b|\bgh\s+issue\s+view\s+([0-9]+)\b", re.I)
_m = _rx_issue.search(os.environ["GLM_TASK_TEXT"])
issue = int(_m.group(1) or _m.group(2)) if _m else None
# glm-review writes this when it ran at all; absent for a run with no review.
_review_record = None
try:
    with open(os.environ["GLM_REVREC"]) as _f:
        _review_record = json.load(_f)
except Exception:
    pass
rec={
 "ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
 "dir": os.environ["GLM_DIR"], "base": os.environ["GLM_BASE"] or None,
 # The branch the run worked on, beside the identifiers already here: dir
 # names a temp worktree that is deleted after an isolated run, so it
 # identifies nothing afterwards — the branch is what a retro can point at.
 "branch": os.environ["GLM_BRANCH"] or None,
 "task": os.environ["GLM_TASK_TEXT"][:500],
 # Present and null when the task named no issue, never omitted: a reader
 # cannot tell an omitted field from a row written before the field existed.
 "issue": issue,
 "session_id": res.get("session_id"), "num_turns": res.get("num_turns"),
 "duration_ms": res.get("duration_ms"), "agent_error": res.get("is_error"),
 "agent_said": (res.get("result") or "")[:500],
 # worker_ok/worker_reason: whether the delegated agent COMPLETED, decided from
 # its exit status and its result event together. A row whose agent fields are
 # all null is indistinguishable from one nobody wrote, so the row must say it
 # did not complete — and why — itself (#91).
 "worker_ok": os.environ.get("GLM_WORKER_OK") == "1",
 "worker_reason": (os.environ.get("GLM_WORKER_REASON") or "").strip() or None,
 "verify_cmd": os.environ["GLM_VERIFY"] or None,
 "verify": os.environ["GLM_VSTATUS"],
 "verify_rc": int(os.environ["GLM_VRC"]) if os.environ["GLM_VRC"] else None,
 "reviewer": os.environ["GLM_REVIEWER"], "review": os.environ["GLM_RVERDICT"],
 # Who actually reviewed, and who was absent. `reviewer` above is what was
 # ASKED for; this is what happened.
 "review_record": _review_record,
 "fix_rounds": int(os.environ["GLM_ROUNDS"]), "review_text": review,
 "log": os.environ["GLM_LOG"],
 "notes": notes,
}
# Records can exceed the atomic-append size, so concurrent runs must lock.
import fcntl
with open(os.environ["GLM_LEDGER"],"a") as f:
    fcntl.flock(f.fileno(), fcntl.LOCK_EX)
    try: f.write(json.dumps(rec)+"\n"); f.flush()
    finally: fcntl.flock(f.fileno(), fcntl.LOCK_UN)
print(f"glm-task: recorded -> {os.environ['GLM_LEDGER']}")
# One machine-readable line with everything a caller needs to resume this run:
# glm-answer takes a session id and works inside the directory the agent used.
# Without this a caller has to re-parse the ledger, which is unreliable when
# several runs are in flight at once — the case the drain is built for.
import sys as _sys
_sys.stderr.write(
    "glm-task: run dir=%s session=%s branch=%s\n"
    % (os.environ.get("GLM_DIR", ""), res.get("session_id") or "", os.environ.get("GLM_BRANCH", ""))
)
PY

# Throttled, not failed. Checked before everything below because a caller that
# retries later gets the work done, while one that reads this as a failure marks
# an item broken that was never actually attempted.
if [[ "${RATE_LIMITED:-0}" == "1" ]]; then
  echo "glm-task: z.ai refused on capacity — this run was NOT attempted, retry later.${RETRY_AFTER:+ It asked for ${RETRY_AFTER}s.}" >&2
  exit 5
fi

# A blocked agent stopped without finishing. A weak verify command can pass over
# unimplemented work, so blocked must never report success.
if grep -q '"level":"blocked"' "$NOTES" 2>/dev/null; then
  echo "glm-task: agent is BLOCKED — the task is NOT complete, whatever verify said." >&2
  exit 4
fi

# The delegated agent did not complete — it could not start, it died, it was
# killed, it reported failure itself, or (#93) it left nothing on the branch
# that will be shipped: uncommitted files, no change at all, commits on a
# branch the ship never pushes, or a git state nobody could read. Checked
# BELOW rate limiting (a throttled run says nothing about the change: the item
# is retried, not marked broken) and BELOW blocked (a question waiting is more
# specific than this), but ABOVE verify and review: verify runs against the
# working tree, so a green verify over work that was never committed is
# exactly the case this catches, and review is skipped altogether when there
# is no committed diff to judge. A weak verify command passing over work that
# was never attempted is why BLOCKED already sits above them (#91).
# Distinct from exit 1, which means a change WAS produced and was found wanting.
if [[ "${WORKER_OK:-0}" != "1" ]]; then
  echo "glm-task: the delegated agent did not complete — ${WORKER_REASON:-no reason recorded}." >&2
  if [[ "$LEFT_UNCOMMITTED" == "1" ]]; then
    echo "glm-task: those files are still in $DIR — recover them before the worktree is removed. glm-task will not commit them on the agent's behalf." >&2
  elif [[ "$STATE_UNKNOWN" == "1" ]]; then
    echo "glm-task: what the branch carries could not be determined, so nothing about this run is certified — inspect $DIR before the worktree is removed." >&2
  else
    echo "glm-task: no change was produced, so verify and review had nothing to judge." >&2
  fi
  exit 6
fi

# An errored review is NOT a pass — it means nothing was checked. Surface it distinctly
# so a broken reviewer can never be mistaken for a clean bill of health.
if [[ "${VSTATUS:-}" == "fail" || "$REVIEW_VERDICT" == "changes_required" ]]; then exit 1; fi
if [[ "$REVIEW_VERDICT" == "error" ]]; then
  echo "glm-task: review did not complete — treat this as UNREVIEWED, not passed." >&2
  exit 2
fi
if [[ "$REVIEW_VERDICT" == "no_capacity" ]]; then
  echo "glm-task: EVERY reviewer is out of capacity — the change is UNREVIEWED." >&2
  echo "glm-task: ask the human whether to ship unreviewed or wait for capacity." >&2
  exit 3
fi
exit 0
