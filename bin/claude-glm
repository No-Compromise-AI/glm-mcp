#!/usr/bin/env bash
# Launch Claude Code CLI against z.ai's Anthropic-compatible endpoint (GLM-5.3).
# Uses an isolated CLAUDE_CONFIG_DIR so your normal Anthropic login/history stay untouched.
set -euo pipefail

# --- resolve the z.ai API key (never hardcode it in this file) ---
# Asked of the server rather than searched for again (#55). This file used to
# reimplement the same three sources in bash, and the two copies had already
# drifted where it mattered: glm-mcp requires GLM_MCP_ALLOW_ZCODE_KEY=1 before
# it will use the key ZCode stores, and this script read that file
# unconditionally — so the wrapper was quietly more permissive than the server
# it wraps. One implementation, and this asks it.
__self="${BASH_SOURCE[0]}"
while [[ -L "$__self" ]]; do
  __dir="$(cd -P "$(dirname -- "$__self")" && pwd)"
  __self="$(readlink -- "$__self")"
  [[ "$__self" != /* ]] && __self="$__dir/$__self"
done
HERE="$(cd -P "$(dirname -- "$__self")" && pwd)"
ENTRY="$HERE/../dist/index.js"

if [[ -z "${ZAI_API_KEY:-}" ]]; then
  if [[ ! -f "$ENTRY" ]]; then
    # No silent fallback to a second copy of the policy: that is the drift this
    # change removes, and a wrapper that quietly disagrees with the server about
    # which credentials are allowed is worse than one that stops.
    echo "claude-glm: $ENTRY is missing — run 'npm ci' (or 'npm run build') in the repo root," >&2
    echo "claude-glm: or export ZAI_API_KEY yourself." >&2
    exit 1
  fi
  if ! ZAI_API_KEY="$(node "$ENTRY" key --print 2>/dev/null)"; then
    echo "No z.ai API key. Put one in ~/.config/zai/api-key or export ZAI_API_KEY." >&2
    echo "claude-glm: to reuse the key ZCode stores, set GLM_MCP_ALLOW_ZCODE_KEY=1." >&2
    exit 1
  fi
fi
if [[ -z "${ZAI_API_KEY:-}" ]]; then
  echo "No z.ai API key. Put one in ~/.config/zai/api-key or export ZAI_API_KEY." >&2
  exit 1
fi

export CLAUDE_CONFIG_DIR="$HOME/.claude-glm"
mkdir -p "$CLAUDE_CONFIG_DIR"

export ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
export ANTHROPIC_AUTH_TOKEN="$ZAI_API_KEY"
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN

# GLM-5.3 = the reasoning model; glm-4.7 for the cheap/fast slot (5.3 forces thinking on).
# Every value below can be overridden by exporting it before calling this script.
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-glm-5.3}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-glm-5.3}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-glm-4.7}"
export CLAUDE_CODE_SUBAGENT_MODEL="${CLAUDE_CODE_SUBAGENT_MODEL:-glm-5.3}"

# GLM-5.3 has a 1M context. Without this, auto-compact fires at the default
# threshold and discards context the model could still hold — costly on long runs.
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-1000000}"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-32000}"

export API_TIMEOUT_MS="${API_TIMEOUT_MS:-3000000}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

exec claude "$@"
