#!/usr/bin/env bash
# Take a finished branch all the way to "verified working", not just "PR opened".
#
#   glm-ship -C ~/proj -b feat/x -t "Title" [-m] [-D deploy.yml] [-V "curl -fsS https://app/health"]
#
#   -b <branch>   branch to ship (default: current)
#   -t <title>    PR title (default: the branch's last commit subject)
#   -B <body>     PR body (default: generated from the commits)
#   -m            arm GitHub auto-merge (squash). NOTE: this selects the
#                 MECHANISM, not whether to merge — without it this tool still
#                 merges once the checks are green. Merging is the job; -m only
#                 decides whether GitHub does it or this loop does
#   -D <workflow> deploy workflow filename to watch after merge
#   -V <cmd>      post-deploy check. THIS is what "done" means; without it the
#                 run reports merged-but-unverified, never done.
#   -R            require at least one check; fail rather than merge unchecked
#   -U            merge even though this branch's own review record says no
#                 reviewer passed it. Says so, loudly, on the way past
#   -T <secs>     overall watch deadline (default 3600)
#
# Escalates through the same notes channel as glm-task: anything that stops the
# change reaching production is written as a `blocked` note and notified.
set -uo pipefail

DIR="$PWD"; BRANCH=""; TITLE=""; BODY=""; AUTOMERGE=0; DEPLOY_WF=""; VERIFY_CMD=""; DEADLINE=5400
REQUIRE_CHECKS=0; ALLOW_UNREVIEWED=0
LEDGER="${GLM_TASK_LEDGER:-$HOME/.claude-glm/outcomes.jsonl}"
# Measured on this account: GitHub can take 2.5-20 MINUTES to create a run after the
# event. Anything shorter than that concludes "no CI" while the run is still pending.
CHECK_GRACE="${GLM_SHIP_CHECK_GRACE:-1500}"
while getopts "C:b:t:B:mD:V:T:RUh" opt; do
  case "$opt" in
    C) DIR="$OPTARG" ;; b) BRANCH="$OPTARG" ;; t) TITLE="$OPTARG" ;; B) BODY="$OPTARG" ;;
    m) AUTOMERGE=1 ;; R) REQUIRE_CHECKS=1 ;; U) ALLOW_UNREVIEWED=1 ;; D) DEPLOY_WF="$OPTARG" ;; V) VERIFY_CMD="$OPTARG" ;; T) DEADLINE="$OPTARG" ;;
    h) grep '^#' "$0" | sed 's/^# \{0,1\}//' | head -18; exit 0 ;;
    *) exit 2 ;;
  esac
done
cd "$DIR" || exit 2
BRANCH="${BRANCH:-$(git branch --show-current)}"
STAMP="$(date +%Y%m%d-%H%M%S)-$$"
NOTES="${GLM_NOTES:-${TMPDIR:-/tmp}/glm-ship-notes-$STAMP.jsonl}"
: > "$NOTES"

note() { # $1 level  $2 message — reaches the human the same way glm-task's do
  printf '{"level":"%s","msg":"%s"}\n' "$1" "$(printf '%s' "$2" | sed 's/"/\\"/g' | tr '\n' ' ')" >> "$NOTES"
  echo "  >>> ship [$1]: $2" >&2
  if [[ "$1" == "blocked" ]]; then
    osascript -e "display notification \"$(printf '%s' "$2" | cut -c1-170 | sed 's/"/\\"/g')\" with title \"Ship blocked\" subtitle \"$BRANCH\" sound name \"Ping\"" >/dev/null 2>&1 || true
  fi
}

say() { echo "glm-ship: $*" >&2; }
START=$SECONDS
past_deadline() { (( SECONDS - START > DEADLINE )); }

WARNED_NOCHECKS=0
say "branch=$BRANCH dir=$DIR"

# ---- what this branch's own record says about review ----------------------
# glm-task marks a change UNREVIEWED when the reviewer errored, when every
# reviewer was out of capacity, or when none was asked for. Until #77 that
# verdict could not be found again — the ledger recorded no branch — so nothing
# downstream could act on it, and the only thing standing between an unreviewed
# change and a merge was glm-drain declining to call this tool. A human running
# it by hand had nothing (#75).
#
# The check gates MERGING, not the -m flag: this tool merges once checks are
# green whether or not auto-merge was armed, so guarding the flag would guard
# nothing.
#
# Matched to THIS branch. Taking the newest row regardless would be wrong in
# exactly the case the tool is for — several delegations in flight, one of them
# failed, and the failure decides someone else's merge.
REVREC_F="${TMPDIR:-/tmp}/glm-ship-record-$STAMP.json"
REVIEW_STATE="$(GLM_LEDGER_F="$LEDGER" GLM_SHIP_BRANCH="$BRANCH" python3 - 2>"$REVREC_F" <<'PYEOF'
import json, os
best = None
try:
    for line in open(os.environ["GLM_LEDGER_F"]):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try: rec = json.loads(line)
        except Exception: continue
        if rec.get("branch") != os.environ["GLM_SHIP_BRANCH"]:
            continue
        # Last row for this branch wins: a re-run supersedes an earlier one.
        # (No apostrophes in this heredoc: bash 3.2, which this repo targets,
        # mis-scans quotes inside a heredoc nested in "$( ... )" and reports an
        # unmatched quote hundreds of lines away.)
        best = rec
except Exception: pass
if best is not None:
    print("%s\t%s\t%s" % (best.get("review") or "", best.get("reviewer") or "", best.get("base") or ""))
    import sys
    json.dump(best.get("review_record") or {}, sys.stderr)
PYEOF
)"
REVIEW_VERDICT_SEEN="$(printf '%s' "$REVIEW_STATE" | cut -f1)"
REVIEW_REVIEWER="$(printf '%s' "$REVIEW_STATE" | cut -f2)"
if [[ -z "$REVIEW_VERDICT_SEEN" ]]; then
  # Not a defect: glm-ship is also the tool a human uses on a branch that never
  # went through glm-task. Said out loud so "nobody reviewed this" cannot be
  # mistaken for "a reviewer passed it".
  say "no review record for $BRANCH — shipping on the checks alone"
elif [[ "$REVIEW_VERDICT_SEEN" == "pass" ]]; then
  say "review=pass (${REVIEW_REVIEWER:-unknown})"
elif [[ $ALLOW_UNREVIEWED -eq 1 ]]; then
  say "review=$REVIEW_VERDICT_SEEN — UNREVIEWED, merging anyway because -U was given (operator override)"
  note scope "merging $BRANCH UNREVIEWED: its record says review=$REVIEW_VERDICT_SEEN and -U was given"
else
  say "review=$REVIEW_VERDICT_SEEN — refusing to merge $BRANCH"
  note blocked "$BRANCH is UNREVIEWED (review=$REVIEW_VERDICT_SEEN${REVIEW_REVIEWER:+, reviewer=$REVIEW_REVIEWER}) and will not be merged. Get a passing review, or re-run with -U to merge it anyway."
  exit 6
fi
git push -u origin "$BRANCH" 2>&1 | tail -2 >&2 || { note blocked "push of $BRANCH failed"; exit 4; }

PR=$(gh pr list --head "$BRANCH" --json number --jq '.[0].number' 2>/dev/null)
if [[ -z "$PR" || "$PR" == "null" ]]; then
  TITLE="${TITLE:-$(git log -1 --format=%s "$BRANCH")}"
  BODY="${BODY:-$(git log --format='- %s' origin/main.."$BRANCH" 2>/dev/null)}"
  PR=$(gh pr create --head "$BRANCH" --title "$TITLE" --body "$BODY" --json number --jq .number 2>/dev/null) \
    || PR=$(gh pr create --head "$BRANCH" --title "$TITLE" --body "$BODY" 2>&1 | grep -oE '[0-9]+$' | tail -1)
fi
[[ -n "$PR" ]] || { note blocked "could not create or find a PR for $BRANCH"; exit 4; }
say "PR #$PR"

# ---- the review record, onto the PR ---------------------------------------
# Until now this lived in ~/.claude-glm/outcomes.jsonl on one machine and died
# there, so the rigour was an assertion in a commit message rather than a
# record (#82). Posted ONCE, here, rather than inside the watch loop below,
# which polls — a comment in that loop becomes a wall of duplicates on a slow PR.
#
# A plain issue comment, never `gh pr review`: main requires review threads to
# be resolved before merge and glm-drain auto-merges unattended, so a tool that
# posted threads would deadlock the drain on its own comments.
CURRENT_HEAD="$(git -C "$DIR" rev-parse "$BRANCH" 2>/dev/null || echo '')"
REVIEW_COMMENT="${TMPDIR:-/tmp}/glm-ship-comment-$STAMP.md"
if GLM_REC_F="$REVREC_F" GLM_REC_CURHEAD="$CURRENT_HEAD" GLM_REC_OUT="$REVIEW_COMMENT" python3 - <<'PYEOF'
import json, os, sys
try:
    rec = json.load(open(os.environ["GLM_REC_F"]))
except Exception:
    rec = None
# Nothing is posted when there is nothing to say. An empty template reads as
# coverage, and inventing a record is worse than having none.
if not rec or not (rec.get("reviewers") or rec.get("absent")):
    sys.exit(1)
L = []
L.append("## Review record")
L.append("")
L.append("_Self-reported by `glm-ship` from this delegation's own ledger. "
         "It is an audit trail, not third-party attestation: nothing here is "
         "verified by GitHub or by the reviewers themselves._")
L.append("")
base, head = rec.get("base") or "", rec.get("head") or ""
L.append("**Reviewed:** `%s..%s`" % (base[:12], head[:12]))
cur = os.environ.get("GLM_REC_CURHEAD") or ""
if head and cur and cur != head:
    L.append("")
    L.append("> **HEAD MOVED after the review.** The review above read `%s`; this PR is at "
             "`%s`. The commits in between were NOT reviewed." % (head[:12], cur[:12]))
L.append("")
if rec.get("reviewers"):
    L.append("| reviewer | model | verdict |")
    L.append("| --- | --- | --- |")
    for r in rec["reviewers"]:
        L.append("| %s | `%s` | %s |" % (r.get("name"), r.get("model"), r.get("verdict")))
else:
    L.append("**No reviewer delivered a verdict.**")
if rec.get("absent"):
    L.append("")
    L.append("**Did not deliver:**")
    for a in rec["absent"]:
        L.append("- `%s` (%s) - %s" % (a.get("name"), a.get("model"), a.get("reason")))
L.append("")
open(os.environ["GLM_REC_OUT"], "w").write("\n".join(L) + "\n")
PYEOF
then
  gh pr comment "$PR" --body-file "$REVIEW_COMMENT" >/dev/null 2>&1 \
    && say "review record posted to #$PR" \
    || note scope "could not post the review record to #$PR"
else
  say "no review record to post"
fi
# If auto-merge cannot be armed we must merge ourselves, or the watch loop waits
# forever for something that will never happen.
ARMED=0
if [[ $AUTOMERGE -eq 1 ]]; then
  if gh pr merge "$PR" --squash --auto >/dev/null 2>&1; then
    ARMED=1; say "auto-merge armed"
  else
    note scope "auto-merge could not be armed on #$PR (repo setting or branch rules); this run will merge it directly once checks are green"
  fi
fi

# ---- watch checks -------------------------------------------------------
say "watching checks…"
while :; do
  past_deadline && { note blocked "PR #$PR: checks still running after ${DEADLINE}s"; exit 4; }
  STATE=$(gh pr view "$PR" --json mergeable,mergeStateStatus,state --jq '[.state,.mergeable,.mergeStateStatus]|@tsv' 2>/dev/null)
  PRSTATE=$(printf '%s' "$STATE" | cut -f1); MERGEABLE=$(printf '%s' "$STATE" | cut -f2)
  MERGESTATE=$(printf '%s' "$STATE" | cut -f3)
  [[ "$PRSTATE" == "MERGED" ]] && break
  [[ "$PRSTATE" == "CLOSED" ]] && { note blocked "PR #$PR was closed without merging"; exit 4; }
  if [[ "$MERGEABLE" == "CONFLICTING" ]]; then
    note blocked "PR #$PR has merge conflicts and cannot merge. Resolve them, then re-run glm-ship."
    exit 4
  fi
  FAILED=$(gh pr checks "$PR" --json name,state --jq '[.[]|select(.state=="FAILURE" or .state=="TIMED_OUT" or .state=="CANCELLED")|.name]|join(", ")' 2>/dev/null)
  if [[ -n "$FAILED" && "$FAILED" != "null" ]]; then
    note blocked "PR #$PR checks failed: $FAILED — not merged. See: gh pr checks $PR"
    exit 4
  fi
  TOTAL=$(gh pr checks "$PR" --json state --jq 'length' 2>/dev/null)
  if [[ "${TOTAL:-0}" == "0" ]]; then
    # Checks are created asynchronously. Merging the instant none exist races the CI
    # that is about to report, so wait out the grace period before concluding there
    # genuinely are none.
    if (( SECONDS - START < CHECK_GRACE )); then
      sleep 10; continue
    fi
    if [[ $WARNED_NOCHECKS -eq 0 ]]; then
      WARNED_NOCHECKS=1
      if [[ $REQUIRE_CHECKS -eq 1 ]]; then
        note blocked "PR #$PR still has no checks after ${CHECK_GRACE}s and -R was given. Not merging something nothing verified."
        exit 4
      fi
      note scope "PR #$PR has no checks after ${CHECK_GRACE}s — nothing is verifying this change before merge."
    fi
  fi
  PENDING=$(gh pr checks "$PR" --json state --jq '[.[]|select(.state=="PENDING" or .state=="QUEUED" or .state=="IN_PROGRESS")]|length' 2>/dev/null)
  if [[ "${PENDING:-0}" == "0" && "$MERGESTATE" == "BLOCKED" ]]; then
    # Checks are done and nothing failed, yet GitHub will not merge. That is a
    # human gate, not a CI problem, and it is its own outcome: waiting for it to
    # hit the deadline and reporting a timeout describes a broken change, when
    # the change is fine and waiting on somebody's click (#82).
    UNRESOLVED=$(gh pr view "$PR" --json reviewThreads \
      --jq '[.reviewThreads[]?|select(.isResolved==false)]|length' 2>/dev/null)
    if [[ -n "$UNRESOLVED" && "$UNRESOLVED" != "null" && "$UNRESOLVED" != "0" ]]; then
      note blocked "PR #$PR is green but has $UNRESOLVED unresolved conversation(s) and cannot merge until they are resolved. Nothing is wrong with the change."
    else
      # The exact reason needs a permission this may not have; name what it can
      # actually be rather than guessing at one.
      note blocked "PR #$PR is green but GitHub will not merge it — an unresolved conversation or a required review is holding it. Nothing is wrong with the change. See: gh pr view $PR"
    fi
    exit 4
  fi
  if [[ "${PENDING:-0}" == "0" ]]; then
    if [[ $ARMED -eq 0 ]]; then
      say "checks green; merging"
      gh pr merge "$PR" --squash >/dev/null 2>&1 || { note blocked "PR #$PR is green but the merge was rejected (branch rules or review required)"; exit 4; }
    fi
  fi
  sleep 15
done
say "PR #$PR merged"

# ---- watch the deploy ---------------------------------------------------
if [[ -n "$DEPLOY_WF" ]]; then
  say "watching deploy workflow $DEPLOY_WF…"
  sleep 10
  RUN=$(gh run list --workflow "$DEPLOY_WF" --limit 1 --json databaseId,status --jq '.[0].databaseId' 2>/dev/null)
  if [[ -z "$RUN" || "$RUN" == "null" ]]; then
    note blocked "merged, but no run of $DEPLOY_WF appeared — the deploy may not have triggered."
    exit 4
  fi
  while :; do
    past_deadline && { note blocked "deploy run $RUN still going after ${DEADLINE}s"; exit 4; }
    read -r ST CC < <(gh run view "$RUN" --json status,conclusion --jq '[.status,.conclusion]|@tsv' 2>/dev/null)
    [[ "$ST" == "completed" ]] && break
    sleep 15
  done
  if [[ "$CC" != "success" ]]; then
    note blocked "deploy $DEPLOY_WF finished '$CC' — the change is merged but NOT deployed. gh run view $RUN --log-failed"
    exit 4
  fi
  say "deploy succeeded"
fi

# ---- verify it actually works ------------------------------------------
if [[ -z "$VERIFY_CMD" ]]; then
  note scope "PR #$PR merged${DEPLOY_WF:+ and deployed}, but no post-deploy check was given, so nothing was verified. This is NOT done."
  say "merged, UNVERIFIED (no -V given)"
  exit 5
fi
say "verifying in the deployed environment: $VERIFY_CMD"
for attempt in 1 2 3; do
  if eval "$VERIFY_CMD" >/dev/null 2>&1; then
    say "VERIFIED — merged, deployed, and working."
    exit 0
  fi
  say "  post-deploy check failed (attempt $attempt/3), retrying in 20s…"
  sleep 20
done
note blocked "PR #$PR merged${DEPLOY_WF:+ and deployed}, but the post-deploy check FAILED three times: $VERIFY_CMD — the change is live and not working."
exit 4
